  "silent_fail_patterns": [
    {
      "pattern": "\\bsounds? like\\b|\\bin the style of\\b|\\bstyle of\\b",
      "message": "Les noms d'artistes (« sounds like X ») sont peu fiables, voire filtrés. Décris le son à la place.",
      "fix": {
        "type": "remove_phrase",
        "regex": "\\b(?:sounds? like|in the style of|style of)\\s+[^,]+,?\\s*"
      }
    },
    {
      "pattern": "\\bsidechain compression\\b|\\bhigh-pass filter\\b|\\bEQ\\b|\\bcompressor ratio\\b",
      "message": "Le jargon de mixage (« sidechain compression », « EQ ») n'est pas interprété. Décris la texture : « pumping, compressed dance mix ».",
      "fix": {
        "type": "replace",
        "map": {
          "sidechain compression": "pumping",
          "high-pass filter": "airy",
          "compressor ratio": "punchy",
          "EQ": "balanced"
        }
      }
    },
    {
      "pattern": "\\b\\d{2,3}\\s*BPM\\b",
      "message": "Les BPM exacts restent approximatifs. Préfère « fast », « mid-tempo », « slow » (sauf si une valeur approchée te va).",
      "fix": {
        "type": "bpm_words"
      }
    },
    {
      "pattern": "\\bno\\s+\\w+|\\bwithout\\s+\\w+",
      "message": "Les consignes négatives (« no drums ») sont peu fiables dans le Style. Mets-les dans le champ Exclude.",
      "fix": {
        "type": "move_to_exclude"
      }
    },
    {
      "pattern": "(^|,)\\s*(sad|happy)\\s*(,|$)",
      "message": "« sad » ou « happy » seuls donnent peu d'information. Une scène concrète est bien plus efficace.",
      "fix": {
        "type": "replace",
        "map": {
          "sad": "rainy evening, quiet heartbreak",
          "happy": "sunny morning, carefree energy"
        }
      }
    }
  ],
