// Icône du programme (Explorateur, barre des tâches), dessinée par installer/make-icon.ps1, et son nom dans Windows.
1 ICON "../../installer/otoko.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "Otoko"
            VALUE "FileDescription", "Otoko Studio Vault Pro"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "otoko"
            VALUE "OriginalFilename", "otoko.exe"
            VALUE "ProductName", "Otoko Studio Vault Pro"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40C, 0x4B0
    END
END
