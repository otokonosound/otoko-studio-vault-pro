// Composants de base du système « Nocturne ».
import { Theme } from "theme.slint";

// Le clavier : passer d'une commande à l'autre avec les flèches (Rust rejoue Tab).
export global Nav {
    callback next();
    callback previous();
}

// Une zone cliquable, à la souris comme au clavier : Tab ou les flèches pour y arriver, Entrée ou Espace pour agir.
// L'anneau ne se montre que si on y est arrivé au clavier.
export component Hit inherits FocusScope {
    in property <length> ring-radius: 9px;
    in property <MouseCursor> cursor: MouseCursor.pointer;
    out property <bool> has-hover: ta.has-hover;
    callback clicked;
    property <bool> keyboard;
    focus-on-click: false;
    focus-gained(reason) => { root.keyboard = reason == FocusReason.tab-navigation; }
    focus-lost(reason) => { root.keyboard = false; }
    key-pressed(e) => {
        if (e.text == Key.Return || e.text == " ") { root.clicked(); return EventResult.accept; }
        if (e.text == Key.RightArrow || e.text == Key.DownArrow) { Nav.next(); return EventResult.accept; }
        if (e.text == Key.LeftArrow || e.text == Key.UpArrow) { Nav.previous(); return EventResult.accept; }
        return EventResult.reject;
    }
    ta := TouchArea {
        mouse-cursor: root.cursor;
        clicked => { root.clicked(); }
    }
    if root.keyboard: Rectangle {
        border-width: 2px;
        border-color: Theme.ember;
        border-radius: root.ring-radius;
    }
}

export component Isle inherits Rectangle {
    background: Theme.ink1;
    border-radius: Theme.radius-l;
    clip: true;
}

// Titre d'une partie de page.
export component H2 inherits Text {
    color: Theme.text;
    font-size: 16px;
    font-weight: 700;
    font-family: Theme.display-font;
}

export component Icon inherits Image {
    in property <color> tint: Theme.text2;
    width: 18px;
    height: 18px;
    colorize: tint;
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.text2;
    in property <color> bg: Theme.ink1;
    height: 28px;
    border-radius: 14px;
    background: bg;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        Text {
            text: root.text;
            color: root.fg;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.text2;
    height: 22px;
    border-radius: 11px;
    background: Theme.ink3;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text { text: root.text; color: root.fg; font-size: 11px; font-weight: 600; vertical-alignment: center; }
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> ghost;
    callback clicked;
    height: 32px;
    border-radius: 9px;
    background: primary ? (ta.has-hover ? Theme.ember.brighter(0.08) : Theme.ember)
        : ghost ? (ta.has-hover ? Theme.ink3 : transparent)
        : (ta.has-hover ? Theme.ink4 : Theme.ink3);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 13px;
        spacing: 7px;
        alignment: center;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: 15px;
                height: 15px;
                tint: root.primary ? #1C0802 : Theme.text;
            }
        }
        Text {
            text: root.text;
            color: root.primary ? #1C0802 : root.ghost ? Theme.text2 : Theme.text;
            font-size: 12.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := Hit {
        clicked => { root.clicked(); }
    }
}

// Bouton de transport carré.
export component TBtn inherits Rectangle {
    in property <image> icon;
    in property <bool> on;
    in property <color> on-bg: Theme.ink3;
    in property <color> tint: Theme.text2;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: on ? on-bg : (ta.has-hover ? Theme.ink3 : transparent);
    Icon {
        source: root.icon;
        tint: root.tint;
    }
    ta := Hit {
        clicked => { root.clicked(); }
    }
}

// Potentiomètre : arc de 270°, la valeur se règle en glissant verticalement.
// Bipolaire : l'arc part du centre. Modulation : une bague fine à l'extérieur, de mod-lo à mod-hi.
// Double-clic : valeur par défaut ; clic droit : `secondary` (moduler, apprendre MIDI…).
export component Knob inherits VerticalLayout {
    in property <string> label;
    in property <string> value-text;
    in-out property <float> value: 0.5;
    in property <color> accent: Theme.ember;
    in property <float> size: 44;
    in property <bool> bipolar;
    in property <float> mod-lo: -1;
    in property <float> mod-hi: -1;
    in property <color> mod-color: Theme.families[3];
    in property <float> default-value: -1;
    /// La valeur ne s'affiche qu'au survol (appareils natifs).
    in property <bool> hover-value;
    /// Pendant le geste (aperçu en direct), puis au relâchement (la modification est enregistrée).
    callback moved-value(float);
    callback released(float);
    callback secondary;
    property <float> a1: -135 + 270 * root.value;
    property <float> sx: 22 + 18 * Math.sin(-135deg);
    property <float> sy: 22 - 18 * Math.cos(-135deg);
    property <float> ex: 22 + 18 * Math.sin(a1 * 1deg);
    property <float> ey: 22 - 18 * Math.cos(a1 * 1deg);
    property <float> tx: 22 + 18 * Math.sin(135deg);
    property <float> ty: 22 - 18 * Math.cos(135deg);
    property <float> m0: -135 + 270 * max(0, min(1, root.mod-lo));
    property <float> m1: -135 + 270 * max(0, min(1, root.mod-hi));
    property <float> start-value;
    property <length> px: root.size * 1px;
    spacing: 5px;
    alignment: start;
    Rectangle {
        width: root.px;
        height: root.px;
        Path {
            width: root.px;
            height: root.px;
            viewbox-width: 44;
            viewbox-height: 44;
            stroke: Theme.ink4;
            stroke-width: 3px;
            commands: "M " + root.sx + " " + root.sy + " A 18 18 0 1 1 " + root.tx + " " + root.ty;
        }
        if !root.bipolar && root.value > 0.005: Path {
            width: root.px;
            height: root.px;
            viewbox-width: 44;
            viewbox-height: 44;
            stroke: root.accent;
            stroke-width: 3px;
            commands: "M " + root.sx + " " + root.sy + " A 18 18 0 " + (270 * root.value > 180 ? "1" : "0") + " 1 " + root.ex + " " + root.ey;
        }
        if root.bipolar && abs(root.value - 0.5) > 0.005: Path {
            width: root.px;
            height: root.px;
            viewbox-width: 44;
            viewbox-height: 44;
            stroke: root.accent;
            stroke-width: 3px;
            commands: "M 22 4 A 18 18 0 0 " + (root.value > 0.5 ? "1" : "0") + " " + root.ex + " " + root.ey;
        }
        if root.mod-hi >= 0 && root.mod-hi - root.mod-lo > 0.004: Path {
            width: root.px;
            height: root.px;
            viewbox-width: 44;
            viewbox-height: 44;
            stroke: root.mod-color;
            stroke-width: 1.5px;
            commands: "M " + (22 + 21 * Math.sin(root.m0 * 1deg)) + " " + (22 - 21 * Math.cos(root.m0 * 1deg))
                + " A 21 21 0 " + (root.m1 - root.m0 > 180 ? "1" : "0") + " 1 " + (22 + 21 * Math.sin(root.m1 * 1deg)) + " " + (22 - 21 * Math.cos(root.m1 * 1deg));
        }
        Rectangle {
            width: root.px * 30 / 44;
            height: root.px * 30 / 44;
            border-radius: self.width / 2;
            background: Theme.dark ? @radial-gradient(circle, #2B3042 0%, #161924 100%) : @radial-gradient(circle, #FFFFFF 0%, #DEDBD3 100%);
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 2px;
        }
        Rectangle {
            x: (22 + 9 * Math.sin(root.a1 * 1deg)) * root.px / 44 - 1.5px;
            y: (22 - 9 * Math.cos(root.a1 * 1deg)) * root.px / 44 - 1.5px;
            width: 3px;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.text;
        }
        ta := TouchArea {
            mouse-cursor: ns-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                    root.secondary();
                }
                if (e.kind == PointerEventKind.down) {
                    root.start-value = root.value;
                }
                if (e.kind == PointerEventKind.up && root.value != root.start-value) {
                    root.released(root.value);
                }
            }
            double-clicked => {
                if (root.default-value >= 0) {
                    root.value = root.default-value;
                    root.released(root.value);
                }
            }
            moved => {
                if (self.pressed) {
                    root.value = max(0, min(1, root.start-value + (self.pressed-y - self.mouse-y) / 150px));
                    root.moved-value(root.value);
                }
            }
        }
    }
    Text { text: root.label; color: Theme.text2; font-size: 10.5px; font-weight: 600; horizontal-alignment: center; }
    Text {
        text: root.value-text;
        color: (root.hover-value && !ta.has-hover && !ta.pressed) ? transparent : Theme.text3;
        font-size: 10px;
        font-family: Theme.mono-font;
        horizontal-alignment: center;
    }
}

// Vumètre vertical stéréo.
export component Meter inherits Rectangle {
    in property <float> left;
    in property <float> right;
    width: 7px;
    Rectangle {
        x: 0;
        width: 3px;
        y: parent.height * (1 - root.left);
        height: parent.height * root.left;
        border-radius: 1.5px;
        background: @linear-gradient(0deg, Theme.lagoon 0%, Theme.lagoon 70%, Theme.ember2 90%, Theme.danger 100%);
    }
    Rectangle {
        x: 4px;
        width: 3px;
        y: parent.height * (1 - root.right);
        height: parent.height * root.right;
        border-radius: 1.5px;
        background: @linear-gradient(0deg, Theme.lagoon 0%, Theme.lagoon 70%, Theme.ember2 90%, Theme.danger 100%);
    }
}
