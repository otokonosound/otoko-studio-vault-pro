  "style_field": {
    "max_chars": 200,
    "descriptor_target_min": 4,
    "descriptor_target_max": 7,
    "formula": "[Genre + Sub-genre], [Tempo/Energy], [Key instruments], [Vocal style], [Production quality], [Mood]",
    "slots": [
      {
        "key": "genre",
        "label": "Genre et sous-genre",
        "placeholder": "dark techno, industrial",
        "hint": "Le plus important : mets-le en premier, c'est ce qui pèse le plus."
      },
      {
        "key": "tempo",
        "label": "Tempo et énergie",
        "placeholder": "128 BPM, driving",
        "hint": "Les BPM exacts restent approximatifs. Préfère « fast », « mid-tempo », « slow »."
      },
      {
        "key": "instruments",
        "label": "Instruments clés",
        "placeholder": "analog bass, distorted 909, metallic percs",
        "hint": "Deux à quatre instruments. V6 comprend bien le vocabulaire précis (« Rhodes », « 303 », « upright bass »)."
      },
      {
        "key": "vocals",
        "label": "Voix",
        "placeholder": "female haunting whisper",
        "hint": "Ex. « breathy female », « deep male baritone », « ethereal choir ». Les noms d'artistes ne marchent pas."
      },
      {
        "key": "production",
        "label": "Production",
        "placeholder": "underground, gritty",
        "hint": "Ex. « lo-fi tape hiss », « polished radio-ready », « vintage tube warmth »."
      },
      {
        "key": "mood",
        "label": "Ambiance",
        "placeholder": "dystopian, hypnotic",
        "hint": "Une scène concrète vaut mieux qu'un mot vague : « rainy Sunday, thinking about someone who left » plutôt que « sad »."
      }
    ]
  },
